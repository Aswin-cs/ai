{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "es2020"],
    "jsx": "react-jsx",
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".test-dist",
    "rootDir": "."
  },
  "include": [
    "lib/**/*.ts",
    "hooks/chatReducer.ts",
    "hooks/onboardingReducer.ts",
    "models/**/*.ts",
    "types/**/*.ts",
    "app/api/**/*.ts",
    "next.config.ts",
    "tests/**/*.test.ts",
    "tests/testAlias.ts"
  ]
}
