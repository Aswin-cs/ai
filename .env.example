# ==============================================================================
# VayuPulse Environment Variables Template
# Copy this file to `.env.local` for local development and fill in your values.
# Never commit real secrets or `.env.local`.
#
# Generate random secrets (NEXTAUTH_SECRET, CRON_SECRET) with:
#   openssl rand -base64 32
# ==============================================================================

# MongoDB connection string for User, AiEvaluation, and TripPlan persistence (required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vayupulse?retryWrites=true&w=majority

# Canonical URL of the running Next.js app (use http://localhost:3000 locally; required in prod)
NEXTAUTH_URL=http://localhost:3000

# Random 32+ byte secret used by NextAuth to sign JWT/session cookies (`openssl rand -base64 32`; required)
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32-secret

# Google OAuth 2.0 Client ID from Google Cloud Console (required for sign-in)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret from Google Cloud Console (required for sign-in)
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Google Gemini API key from Google AI Studio used by @google/genai (required; or set GOOGLE_API_KEY)
GEMINI_API_KEY=your-gemini-api-key

# Alternative Gemini API key fallback read if GEMINI_API_KEY is unset (optional when GEMINI_API_KEY is set)
# GOOGLE_API_KEY=your-google-api-key

# Bearer secret protecting the scheduled cron endpoint GET /api/ai/plan/auto-update (`openssl rand -base64 32`)
CRON_SECRET=replace-with-cron-bearer-secret

# Open Government Data (data.gov.in) API key for official Indian CPCB station AQI lookups (optional; falls back to Open-Meteo)
DATA_GOV_API_KEY=your-data-gov-in-api-key
