{
  "name": "urban-air-quality",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "pretest": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\"",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/tests/**/*.test.js\"",
    "test:coverage": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test --experimental-test-coverage \".test-dist/tests/**/*.test.js\"",
    "test:components": "vitest run",
    "test:components:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.77.0",
    "material-symbols": "^0.49.0",
    "mongoose": "^9.12.3",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^25.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  }
}
